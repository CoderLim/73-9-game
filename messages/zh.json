  "game.highlights.eyebrow": "重点",
  "game.highlights.title": "73-9 凭什么好玩",
  "game.highlights.wheel.title": "转盘选秀",
  "game.highlights.wheel.description": "五次旋转，五个随机球队赛季。每次只能签一人——不能在整个联盟里挑花。",
  "game.highlights.cap.title": "2026 帽薪换算",
  "game.highlights.cap.description": "每份合同都按当今薪资帽世界缩放。1 亿预算有真实压力，超支必有代价。",
  "game.highlights.sim.title": "勇士试炼",
  "game.highlights.sim.description": "82 场模拟告诉你你的五人组击穿 73-9 铁壁的频率——外加本局理论最佳阵容。",
  "game.footer.tagline": "组建能击败 2015-16 勇士的五人组。免费游玩：73-9.org。",
  "game.footer.copyright": "© {year} 73-9.org",
  "game.footer.how_to_play": "怎么玩",
  "game.footer.how_it_works": "工作原理",
  "game.footer.about": "关于",
